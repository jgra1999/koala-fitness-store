---
interface Props {
	name: string
	link: string
}

const { name, link } = Astro.props
---

<a
	href={link}
	class='w-full sm:w-2/4 text-black lg:w-1/3 max-w-[430px] sm:max-w-none py-2 bg-[#d1d1d1] active:text-white lg:hover:text-white active:bg-primary lg:hover:bg-primary font-bold text-xl rounded text-center transition-colors duration-200'
>
	{name}
</a>
